<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.savonitar.flink.stability</groupId>
        <artifactId>flink-stability</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>flink-job-generator</artifactId>

    <properties>
        <!-- Keep the workload bytecode Java-11-compatible; Flink 2.2 sets the runtime JDK floor. -->
        <workload.compiler.release>11</workload.compiler.release>
        <maven.compiler.release>${workload.compiler.release}</maven.compiler.release>
        <flink.version>2.2.0</flink.version>
        <flink.kafka.connector.version>5.0.0-2.2</flink.kafka.connector.version>
        <!-- Preserve the older property as the default for existing build scripts. -->
        <kafka.connector.version>${flink.kafka.connector.version}</kafka.connector.version>
        <kafka.connector.groupId>org.apache.flink</kafka.connector.groupId>
        <kafka.clients.version>4.0.0</kafka.clients.version>
        <workload.build.directory>${project.basedir}/target</workload.build.directory>
        <workload.build.mode>correct</workload.build.mode>
    </properties>

    <dependencies>
        <!-- The Flink image and verified connector bundle supply all runtime libraries. -->
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-streaming-java</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.flink</groupId>
            <artifactId>flink-connector-base</artifactId>
            <version>${flink.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>${kafka.connector.groupId}</groupId>
            <artifactId>flink-connector-kafka</artifactId>
            <version>${kafka.connector.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.clients.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <directory>${workload.build.directory}</directory>
        <finalName>flink-job-generator</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/build-identity</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>require-clean-workload-version-change</id>
                        <phase>validate</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <arguments>
                                <argument>${project.basedir}/WorkloadBuildGuard.java</argument>
                                <argument>${project.build.directory}</argument>
                                <argument>${flink.version}</argument>
                                <argument>${kafka.connector.groupId}</argument>
                                <argument>${kafka.connector.version}</argument>
                                <argument>${maven.compiler.release}</argument>
                                <argument>${kafka.clients.version}</argument>
                                <argument>${workload.build.mode}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>org.savonitar.flink.stability.flinkjob.FlinkKafkaEosJob</mainClass>
                        </manifest>
                        <manifestEntries>
                            <Flink-Stability-Workload-Protocol>v1</Flink-Stability-Workload-Protocol>
                            <Flink-Stability-Workload-Capabilities>keyed-prefix-v1</Flink-Stability-Workload-Capabilities>
                            <Flink-Stability-Workload-Build-Mode>${workload.build.mode}</Flink-Stability-Workload-Build-Mode>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>state-reset-on-restore</id>
            <properties>
                <workload.build.mode>reset-state-on-restore-v1</workload.build.mode>
                <workload.build.directory>${project.basedir}/target/state-reset-on-restore</workload.build.directory>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <configuration>
                            <classifier>state-reset-on-restore</classifier>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
