<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.savonitar.flink.stability</groupId>
    <artifactId>flink-stability-inevitable</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>runtime-api</module>
        <module>cli</module>
        <module>core</module>
        <module>kroxylicious-fault-filter</module>
        <module>testcontainers</module>
        <module>flink-job-generator</module>
    </modules>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <log4j.version>2.23.1</log4j.version>
        <slf4j.version>2.0.17</slf4j.version>
        <junit.version>5.13.3</junit.version>
        <maven-resolver.version>1.9.25</maven-resolver.version>
    </properties>

    <build>
        <plugins>
            <!-- Fail in the validate phase on a wrong JDK, instead of a late
                 "class file version 65.0" error from compilation or surefire. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>require-jdk-21</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>flink-stability requires JDK 21 or newer. Point JAVA_HOME at a JDK 21 installation and rerun Maven.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Scenario runs write logs and Flink checkpoints to the repository root,
                 outside any target/ directory. Have `mvn clean` remove them too. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.3.2</version>
                <inherited>false</inherited>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${maven.multiModuleProjectDirectory}/logs</directory>
                        </fileset>
                        <fileset>
                            <directory>${maven.multiModuleProjectDirectory}/cli/logs</directory>
                        </fileset>
                        <fileset>
                            <directory>${maven.multiModuleProjectDirectory}/checkpoints</directory>
                        </fileset>
                        <fileset>
                            <directory>${maven.multiModuleProjectDirectory}/.flink-stability</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
