{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savonitar.org/flink-stability/schema/scenario-v1.schema.json",
  "title": "Flink Stability Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "meta",
    "runs",
    "setup",
    "subject",
    "workload",
    "phases",
    "terminal_validations"
  ],
  "properties": {
    "format": {
      "const": "v1"
    },
    "kind": {
      "const": "scenario"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    },
    "runs": {
      "$ref": "#/$defs/positiveIntegerOrTemplate"
    },
    "health_retry_limit": {
      "$ref": "#/$defs/nonNegativeIntegerOrTemplate",
      "default": 1
    },
    "setup": {
      "$ref": "#/$defs/setup"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "workload": {
      "$ref": "#/$defs/workload"
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "terminal_validations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/terminalValidation"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebabName"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tickets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/parameterName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameter"
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "boolean",
            "duration"
          ]
        },
        "default": {
          "type": [
            "string",
            "integer",
            "boolean"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "default"
          ],
          "not": {
            "required": [
              "required"
            ]
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "string"
                  }
                }
              },
              "then": {
                "properties": {
                  "default": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "integer"
                  }
                }
              },
              "then": {
                "properties": {
                  "default": {
                    "type": "integer"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "boolean"
                  }
                }
              },
              "then": {
                "properties": {
                  "default": {
                    "type": "boolean"
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "min"
                      ]
                    },
                    {
                      "required": [
                        "max"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "duration"
                  }
                }
              },
              "then": {
                "properties": {
                  "default": {
                    "$ref": "#/$defs/duration"
                  }
                },
                "not": {
                  "anyOf": [
                    {
                      "required": [
                        "min"
                      ]
                    },
                    {
                      "required": [
                        "max"
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "required": [
            "required"
          ],
          "properties": {
            "required": {
              "const": true
            }
          },
          "not": {
            "required": [
              "default"
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "type": {
                  "const": "integer"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "varies",
        "baseline",
        "candidate"
      ],
      "properties": {
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "varies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/parameterName"
          },
          "uniqueItems": true
        },
        "baseline": {
          "$ref": "#/$defs/parameterOverrides"
        },
        "candidate": {
          "$ref": "#/$defs/parameterOverrides"
        }
      }
    },
    "parameterOverrides": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/parameterName"
      },
      "additionalProperties": {
        "type": [
          "string",
          "integer",
          "boolean"
        ]
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kafka",
        "flink"
      ],
      "properties": {
        "kafka": {
          "$ref": "#/$defs/kafkaSetup"
        },
        "flink": {
          "$ref": "#/$defs/flinkSetup"
        },
        "proxies": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/kebabName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/proxy"
          }
        }
      }
    },
    "kafkaSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clusters"
      ],
      "properties": {
        "clusters": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 2,
          "propertyNames": {
            "$ref": "#/$defs/kebabName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/kafkaCluster"
          }
        }
      }
    },
    "kafkaCluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "brokers",
        "topics"
      ],
      "properties": {
        "image": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "mode": {
          "$ref": "#/$defs/nonEmptyString",
          "default": "kraft"
        },
        "brokers": {
          "$ref": "#/$defs/positiveIntegerOrTemplate"
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/kafkaTopic"
          }
        }
      }
    },
    "kafkaTopic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "partitions",
        "replication_factor"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/kafkaNameOrTemplate"
        },
        "partitions": {
          "$ref": "#/$defs/positiveIntegerOrTemplate"
        },
        "replication_factor": {
          "$ref": "#/$defs/positiveIntegerOrTemplate"
        },
        "input_source": {
          "$ref": "#/$defs/inputSource"
        }
      }
    },
    "inputSource": {
      "oneOf": [
        {
          "$ref": "#/$defs/fileInputSource"
        },
        {
          "$ref": "#/$defs/generatedInputSource"
        },
        {
          "$ref": "#/$defs/generatedRateInputSource"
        },
        {
          "$ref": "#/$defs/customInputSource"
        }
      ]
    },
    "fileInputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "format",
        "path"
      ],
      "properties": {
        "mode": {
          "const": "file"
        },
        "format": {
          "$ref": "#/$defs/inputFormatOrTemplate"
        },
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "connect_via_proxy": {
          "$ref": "#/$defs/kebabName"
        }
      }
    },
    "generatedInputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "format",
        "total"
      ],
      "properties": {
        "mode": {
          "const": "generated"
        },
        "format": {
          "$ref": "#/$defs/inputFormatOrTemplate"
        },
        "total": {
          "$ref": "#/$defs/positiveIntegerOrTemplate"
        },
        "connect_via_proxy": {
          "$ref": "#/$defs/kebabName"
        }
      }
    },
    "generatedRateInputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "format",
        "total",
        "rate_per_second"
      ],
      "properties": {
        "mode": {
          "const": "generated-rate"
        },
        "format": {
          "$ref": "#/$defs/inputFormatOrTemplate"
        },
        "total": {
          "$ref": "#/$defs/positiveIntegerOrTemplate"
        },
        "rate_per_second": {
          "$ref": "#/$defs/positiveIntegerOrTemplate"
        },
        "connect_via_proxy": {
          "$ref": "#/$defs/kebabName"
        }
      }
    },
    "customInputSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "artifact",
        "timeout"
      ],
      "properties": {
        "mode": {
          "const": "custom"
        },
        "artifact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "timeout": {
          "$ref": "#/$defs/durationOrTemplate"
        },
        "connect_via_proxy": {
          "$ref": "#/$defs/kebabName"
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "flinkSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "jobmanagers": {
          "$ref": "#/$defs/positiveIntegerOrTemplate",
          "default": 1
        },
        "taskmanagers": {
          "$ref": "#/$defs/positiveIntegerOrTemplate",
          "default": 1
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cluster",
        "listen",
        "bootstrap"
      ],
      "properties": {
        "type": {
          "const": "kroxylicious"
        },
        "cluster": {
          "$ref": "#/$defs/kebabName"
        },
        "listen": {
          "$ref": "#/$defs/addressOrTemplate"
        },
        "bootstrap": {
          "$ref": "#/$defs/proxyBootstrap"
        }
      }
    },
    "proxyBootstrap": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cluster"
          ],
          "properties": {
            "cluster": {
              "$ref": "#/$defs/kebabName"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address"
          ],
          "properties": {
            "address": {
              "$ref": "#/$defs/addressOrTemplate"
            }
          }
        }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connectors"
      ],
      "properties": {
        "connectors": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/kebabName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/subjectConnector"
          }
        }
      }
    },
    "subjectConnector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runtime_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifact": {
                "$ref": "#/$defs/templatedString"
              }
            },
            "required": [
              "artifact"
            ]
          },
          "else": {
            "if": {
              "properties": {
                "artifact": {
                  "type": "string",
                  "not": {
                    "pattern": "^maven:"
                  }
                }
              },
              "required": [
                "artifact"
              ]
            },
            "then": {
              "required": [
                "runtime_dependencies"
              ]
            }
          }
        }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/job"
          }
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "jar",
        "parallelism",
        "source",
        "sink",
        "checkpointing"
      ],
      "properties": {
        "alias": {
          "$ref": "#/$defs/kebabName"
        },
        "start": {
          "type": "string",
          "enum": [
            "auto",
            "manual"
          ],
          "default": "auto"
        },
        "jar": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "connectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/kebabName"
          },
          "uniqueItems": true
        },
        "parallelism": {
          "$ref": "#/$defs/positiveIntegerOrTemplate"
        },
        "state_backend": {
          "$ref": "#/$defs/stateBackend"
        },
        "state_ttl": {
          "$ref": "#/$defs/stateTtl"
        },
        "watermarks": {
          "$ref": "#/$defs/watermarks"
        },
        "restart_strategy": {
          "$ref": "#/$defs/restartStrategy"
        },
        "source": {
          "$ref": "#/$defs/topicRef"
        },
        "sink": {
          "$ref": "#/$defs/sink"
        },
        "checkpointing": {
          "$ref": "#/$defs/checkpointing"
        },
        "program_args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "topicRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "topic"
      ],
      "properties": {
        "cluster": {
          "$ref": "#/$defs/kebabName"
        },
        "topic": {
          "$ref": "#/$defs/kafkaNameOrTemplate"
        },
        "connect_via_proxy": {
          "$ref": "#/$defs/kebabName"
        }
      }
    },
    "sink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster",
        "topic",
        "delivery_guarantee"
      ],
      "properties": {
        "cluster": {
          "$ref": "#/$defs/kebabName"
        },
        "topic": {
          "$ref": "#/$defs/kafkaNameOrTemplate"
        },
        "connect_via_proxy": {
          "$ref": "#/$defs/kebabName"
        },
        "delivery_guarantee": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "transactional_id_prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "transaction_id_naming_strategy": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery_guarantee": {
                "const": "EXACTLY_ONCE"
              }
            },
            "required": [
              "delivery_guarantee"
            ]
          },
          "then": {
            "required": [
              "transactional_id_prefix",
              "transaction_id_naming_strategy"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "delivery_guarantee": {
                "enum": [
                  "NONE",
                  "AT_LEAST_ONCE"
                ]
              }
            },
            "required": [
              "delivery_guarantee"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "transactional_id_prefix"
                  ]
                },
                {
                  "required": [
                    "transaction_id_naming_strategy"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "checkpointing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interval",
        "mode"
      ],
      "properties": {
        "interval": {
          "$ref": "#/$defs/durationOrTemplate"
        },
        "mode": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "EXACTLY_ONCE",
                "AT_LEAST_ONCE"
              ]
            },
            {
              "$ref": "#/$defs/templatedString"
            }
          ]
        },
        "storage": {
          "$ref": "#/$defs/checkpointStorage"
        }
      }
    },
    "checkpointStorage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "jobmanager"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "filesystem"
              ]
            },
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "$ref": "#/$defs/templatedString"
            },
            "path": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "stateBackend": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "stateTtl": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "ttl"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "ttl": {
              "$ref": "#/$defs/durationOrTemplate"
            },
            "cleanup": {
              "$ref": "#/$defs/stateTtlCleanup"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "$ref": "#/$defs/templateString"
            },
            "ttl": {
              "$ref": "#/$defs/durationOrTemplate"
            },
            "cleanup": {
              "$ref": "#/$defs/stateTtlCleanup"
            }
          }
        }
      ]
    },
    "stateTtlCleanup": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "incremental",
            "rocksdb-compaction-filter"
          ]
        },
        {
          "$ref": "#/$defs/templatedString"
        }
      ]
    },
    "watermarks": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "const": "no-watermarks"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "const": "monotonic-timestamps"
            },
            "idleness": {
              "$ref": "#/$defs/durationOrTemplate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "max_out_of_orderness"
          ],
          "properties": {
            "strategy": {
              "const": "bounded-out-of-orderness"
            },
            "max_out_of_orderness": {
              "$ref": "#/$defs/durationOrTemplate"
            },
            "idleness": {
              "$ref": "#/$defs/durationOrTemplate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy"
          ],
          "properties": {
            "strategy": {
              "$ref": "#/$defs/templatedString"
            },
            "max_out_of_orderness": {
              "$ref": "#/$defs/durationOrTemplate"
            },
            "idleness": {
              "$ref": "#/$defs/durationOrTemplate"
            }
          }
        }
      ]
    },
    "restartStrategy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "attempts",
            "delay"
          ],
          "properties": {
