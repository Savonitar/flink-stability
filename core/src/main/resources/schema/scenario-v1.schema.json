          "type": "string",
          "enum": [
            "taskmanager",
            "jobmanager",
            "broker"
          ]
        },
        "name": {
          "$ref": "#/$defs/kebabName"
        }
      }
    },
    "selectorTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "role",
        "hosting"
      ],
      "properties": {
        "kind": {
          "const": "selector"
        },
        "role": {
          "type": "string",
          "enum": [
            "taskmanager"
          ]
        },
        "hosting": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "job",
            "vertex",
            "subtask"
          ],
          "properties": {
            "job": {
              "$ref": "#/$defs/kebabName"
            },
            "vertex": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "subtask": {
              "$ref": "#/$defs/nonNegativeIntegerOrTemplate"
            }
          }
        }
      }
    },
    "networkTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster"
      ],
      "properties": {
        "cluster": {
          "$ref": "#/$defs/kebabName"
        },
        "broker": {
          "$ref": "#/$defs/kebabName"
        }
      }
    },
    "networkMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api"
      ],
      "properties": {
        "api": {
          "type": "string",
          "enum": [
            "produce",
            "fetch",
            "metadata",
            "init-producer-id",
            "add-partitions-to-txn",
            "add-offsets-to-txn",
            "txn-offset-commit",
            "end-txn"
          ]
        },
        "topic": {
          "$ref": "#/$defs/kafkaNameOrTemplate"
        },
        "transactional_id_prefix": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "networkFault": {
      "oneOf": [
        {
          "type": "object",
