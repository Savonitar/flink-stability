              "$ref": "#/$defs/durationOrTemplate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "disconnect"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "error"
          ],
          "properties": {
            "type": {
              "const": "error-response"
            },
            "error": {
              "$ref": "#/$defs/kebabName"
            }
          }
        }
      ]
