    "terminalValidation": {
      "oneOf": [
        {
          "$ref": "#/$defs/kafkaIdSetValidation"
        },
        {
          "$ref": "#/$defs/kafkaNoHangingTransactionsValidation"
        },
        {
          "$ref": "#/$defs/kafkaRecordCountValidation"
        },
        {
          "$ref": "#/$defs/flinkLogMatchValidation"
        },
        {
          "$ref": "#/$defs/customTerminalValidation"
        }
      ]
    },
    "kafkaIdSetValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cluster",
        "topic",
        "expected"
      ],
      "properties": {
        "type": {
          "const": "kafka.id-set"
        },
        "cluster": {
          "$ref": "#/$defs/kebabName"
        },
        "topic": {
          "$ref": "#/$defs/kafkaNameOrTemplate"
        },
        "expected": {
          "const": "input-manifest"
        }
      }
    },
    "kafkaNoHangingTransactionsValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cluster",
        "transactional_id_prefix",
        "stabilization_timeout"
      ],
      "properties": {
        "type": {
          "const": "kafka.no-hanging-transactions"
        },
        "cluster": {
          "$ref": "#/$defs/kebabName"
        },
        "transactional_id_prefix": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stabilization_timeout": {
          "$ref": "#/$defs/durationOrTemplate"
        }
      }
    },
    "kafkaRecordCountValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cluster",
        "topic",
        "expected_records"
      ],
      "properties": {
        "type": {
          "const": "kafka.record-count"
        },
        "cluster": {
          "$ref": "#/$defs/kebabName"
        },
        "topic": {
          "$ref": "#/$defs/kafkaNameOrTemplate"
        },
        "expected_records": {
          "$ref": "#/$defs/positiveIntegerOrTemplate"
        }
      }
    },
    "flinkLogMatchValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "job",
        "pattern"
      ],
      "properties": {
        "type": {
          "const": "flink.log-match"
        },
        "job": {
          "$ref": "#/$defs/kebabName"
        },
        "pattern": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "customTerminalValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "artifact",
        "timeout"
      ],
      "properties": {
        "type": {
          "const": "custom"
        },
        "artifact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "timeout": {
          "$ref": "#/$defs/durationOrTemplate"
        },
        "failure_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/customFailureReason"
          },
          "uniqueItems": true
        },
        "config": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        }
      }
    },
    "inputFormat": {
      "type": "string",
      "enum": [
        "integer-sequence",
        "json-lines",
        "csv"
      ]
    },
    "inputFormatOrTemplate": {
      "oneOf": [
        {
          "$ref": "#/$defs/inputFormat"
        },
        {
          "$ref": "#/$defs/templatedString"
        }
      ]
    },
    "durationOrTemplate": {
      "oneOf": [
        {
          "$ref": "#/$defs/duration"
        },
        {
          "$ref": "#/$defs/templatedString"
        }
      ]
    },
    "positiveIntegerOrTemplate": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "$ref": "#/$defs/templateString"
        }
      ]
    },
    "nonNegativeIntegerOrTemplate": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "$ref": "#/$defs/templateString"
        }
      ]
    },
    "booleanOrTemplate": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/templateString"
        }
      ]
    },
    "duration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
    },
    "address": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+:([1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"
    },
    "addressOrTemplate": {
      "oneOf": [
        {
          "$ref": "#/$defs/address"
        },
        {
          "$ref": "#/$defs/templatedString"
        }
      ]
    },
    "templateString": {
      "type": "string",
      "pattern": "^\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}$"
    },
    "templatedString": {
      "type": "string",
      "pattern": "^(?=.*\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}).+$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "customFailureReason": {
      "type": "string",
      "pattern": "^validator\\.custom\\.[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "parameterName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "kebabName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kafkaName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "kafkaNameOrTemplate": {
      "oneOf": [
        {
          "$ref": "#/$defs/kafkaName"
        },
        {
          "$ref": "#/$defs/templatedString"
        }
      ]
    }
  }
}
