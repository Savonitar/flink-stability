{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savonitar.org/flink-stability/schema/expected-result-v1.schema.json",
  "title": "Flink Stability Expected Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "kind",
    "meta",
    "default"
  ],
  "properties": {
    "format": {
      "const": "v1"
    },
    "kind": {
      "const": "expected-result"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "default": {
      "oneOf": [
        {
          "$ref": "#/$defs/plainExpectation"
        },
        {
          "$ref": "#/$defs/experimentExpectation"
        }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scenario"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/kebabNameWithExpectedSuffix"
        },
        "scenario": {
          "$ref": "#/$defs/kebabName"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "case": {
      "oneOf": [
        {
          "$ref": "#/$defs/plainCase"
        },
        {
          "$ref": "#/$defs/experimentCase"
        }
      ]
    },
    "plainCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when"
      ],
      "properties": {
        "when": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/parameterName"
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "reason": {
          "$ref": "#/$defs/reasonCode"
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/plainPassCase"
        },
        {
          "$ref": "#/$defs/plainFailCase"
        }
      ]
    },
    "plainPassCase": {
      "required": [
        "when",
        "outcome"
      ],
      "properties": {
        "outcome": {
          "const": "pass"
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "oracle"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ]
      }
    },
    "plainFailCase": {
      "required": [
        "when",
        "outcome",
        "oracle",
        "reason"
      ],
      "properties": {
        "outcome": {
          "const": "fail"
        }
      }
    },
    "experimentCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "when",
        "baseline",
        "candidate"
      ],
      "properties": {
        "when": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/parameterName"
          },
          "additionalProperties": {
            "type": [
              "string",
              "integer",
              "boolean"
            ]
          }
        },
        "baseline": {
          "$ref": "#/$defs/baselineExpectation"
        },
        "candidate": {
          "$ref": "#/$defs/sideExpectation"
        }
      }
    },
    "plainExpectation": {
      "oneOf": [
        {
          "$ref": "#/$defs/plainPassExpectation"
        },
        {
          "$ref": "#/$defs/plainFailExpectation"
        }
      ]
    },
    "plainPassExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "const": "pass"
        }
      }
    },
    "plainFailExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "oracle",
        "reason"
      ],
      "properties": {
        "outcome": {
          "const": "fail"
        },
        "oracle": {
          "$ref": "#/$defs/oracle"
        },
        "reason": {
          "$ref": "#/$defs/reasonCode"
        }
      }
    },
    "experimentExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate"
      ],
      "properties": {
        "baseline": {
          "$ref": "#/$defs/baselineExpectation"
        },
        "candidate": {
          "$ref": "#/$defs/sideExpectation"
        }
      }
    },
    "baselineExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "const": "pass"
        }
      }
    },
    "sideExpectation": {
      "oneOf": [
        {
          "$ref": "#/$defs/plainPassExpectation"
        },
        {
          "$ref": "#/$defs/plainFailExpectation"
        }
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "pass",
        "fail"
      ]
    },
    "oracle": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "kebabName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "kebabNameWithExpectedSuffix": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*\\.expected$"
    },
    "parameterName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    }
  }
}
