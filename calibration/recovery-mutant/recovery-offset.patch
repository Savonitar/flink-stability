+    // Deliberately corrupt only checkpoint copies, never live state or Kafka commit offsets.
+    private List<KafkaPartitionSplit> calibrationCheckpointCopies(
+            List<KafkaPartitionSplit> splits, long checkpointId) {
+        List<KafkaPartitionSplit> copies = new ArrayList<>(splits.size());
+        for (KafkaPartitionSplit split : splits) {
+            long from = split.getStartingOffset();
+            long stop = split.getStoppingOffset().orElse(KafkaPartitionSplit.NO_STOPPING_OFFSET);
+            if (from >= 0 && stop >= 0 && from < stop) {
+                long to = from + 1; // from < stop prevents overflow, even when stop is Long.MAX_VALUE.
+                copies.add(new KafkaPartitionSplit(split.getTopicPartition(), to, stop));
+                System.err.println("CALIBRATION_RECOVERY_SNAPSHOT checkpoint=" + checkpointId
+                        + " topic=" + split.getTopic() + " partition=" + split.getPartition()
+                        + " from=" + from + " to=" + to + " stop=" + stop + " process=" + System.getenv("HOSTNAME"));
+            } else {
+                copies.add(split);
+            }
+        }
+        return copies;
+    }
